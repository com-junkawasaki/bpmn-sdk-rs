  "id": "https://gftd.ai/project/bpmn-sdk",
  "type": "ex:Project",
  "name": "BPMN SDK - Rust DSL",
  "description": "Type-safe Rust DSL for declarative BPMN process modeling. Provides a fluent, compile-time validated API for building BPMN 2.0 process definitions.",
  "goal": "Create a complete type-safe Rust DSL for declarative BPMN process modeling that compiles to bpmn-engine's ProcessDefinition format",
  "status": "active",
  "schemaVersion": "0.1.0",
  "conformsTo": [
    "https://gftd.ai/standards/semantic-driven-development",
    "https://gftd.ai/standards/owl-driven-development"
  ],
  "tags": ["rust", "bpmn", "dsl", "workflow", "process-modeling", "type-safe"],
  "capabilities": [
    {
      "id": "ex:capability:dsl-modeling",
      "name": "DSL Process Modeling",
      "description": "Type-safe DSL for building BPMN process definitions"
    },
    {
      "id": "ex:capability:validation",
      "name": "Static Validation",
      "description": "Validate process definitions before compilation"
    },
    {
      "id": "ex:capability:human-tasks",
      "name": "Human Task Management",
      "description": "Support for user tasks, SLAs, and escalation"
    },
    {
      "id": "ex:capability:observability",
      "name": "Monitoring & Observability",
      "description": "Metrics, tracing, and alerting support"
    }
  ],
  "activities": [
    {
      "id": "ex:activity:dsl-construction",
      "name": "DSL Construction",
      "description": "Build BPMN processes using fluent DSL API"
    },
    {
      "id": "ex:activity:validation",
      "name": "Process Validation",
      "description": "Validate process structure and semantics"
    },
    {
      "id": "ex:activity:compilation",
      "name": "Compilation",
      "description": "Compile DSL IR to ProcessDefinition"
    },
    {
      "id": "ex:activity:runtime-integration",
      "name": "Runtime Integration",
      "description": "Integrate with bpmn-engine for execution"
    }
  ],
  "dependsOn": [
    "https://gftd.ai/project/bpmn-engine"
  ],
