{
  "@context": {
    "@version": 1.1,
    "id": "@id",
    "type": "@type",
    "ex": "https://gftd.ai/bpmn-sdk#",
    "dct": "http://purl.org/dc/terms/",
    "name": "dct:title",
    "description": "dct:description",
    "capability": {"@id": "ex:realizesCapability", "@type": "@id"}
  },
  "@graph": [
    {
      "id": "ex:activity:dsl-construction",
      "type": "ex:Activity",
      "name": "DSL Construction",
      "description": "Build BPMN processes using fluent DSL API with type-safe builders",
      "capability": "ex:capability:dsl-modeling"
    },
    {
      "id": "ex:activity:validation",
      "type": "ex:Activity",
      "name": "Process Validation",
      "description": "Validate process structure, semantics, and reachability",
      "capability": "ex:capability:validation"
    },
    {
      "id": "ex:activity:compilation",
      "type": "ex:Activity",
      "name": "Compilation",
      "description": "Compile DSL IR to ProcessDefinition format for bpmn-engine",
      "capability": "ex:capability:runtime-integration"
    },
    {
      "id": "ex:activity:human-task-management",
      "type": "ex:Activity",
      "name": "Human Task Management",
      "description": "Manage user tasks, track SLAs, handle escalation",
      "capability": "ex:capability:human-tasks"
    },
    {
      "id": "ex:activity:monitoring",
      "type": "ex:Activity",
      "name": "Process Monitoring",
      "description": "Collect metrics, traces, and generate alerts",
      "capability": "ex:capability:observability"
    }
  ]
}

